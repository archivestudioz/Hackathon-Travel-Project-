# Roam — copy to .env and fill in. Never commit .env.

# ---- Supabase ---------------------------------------------------------------
# Project settings -> API. Enable Authentication -> Providers -> Anonymous.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server-side only: simulator + ingestion. Never ships to the browser.
SUPABASE_DB_URL=                    # postgres://... for psql / migrations

# ---- Protomaps (basemap) ----------------------------------------------------
# Global vector tiles. Free under 1M requests/month, non-commercial.
PROTOMAPS_API_KEY=

# ---- Sponsors ---------------------------------------------------------------
# ElevenLabs: narration, generated at BUILD time into Supabase Storage.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=                # a premade voice id; multilingual v2 covers all 5 locales

# Tavily: build-time enrichment (blurbs, "known for", hidden gems).
TAVILY_API_KEY=

# Stay22: affiliate links on venues and event stops. The embed widget needs no key.
STAY22_PARTNER_ID=

# ---- Optional event sources (V1 — not called during judging) ----------------
TICKETMASTER_API_KEY=
SEATGEEK_CLIENT_ID=
