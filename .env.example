# Japan travel discovery engine — copy to .env. Never commit .env.

# ---- Supabase ---------------------------------------------------------------
# Project settings -> API. Enable Authentication -> Providers -> Anonymous.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=      # ingestion only, server-side. Never ships to the browser.
SUPABASE_DB_URL=                # postgres://... for psql / migrations

# ---- Sponsors (build-time only; never called during a demo) -----------------
STAY22_PARTNER_ID=              # Direct Travel API: accommodation near a venue
TAVILY_API_KEY=                 # enrichment: descriptions, hidden-gem signals
AEROXPLORER_API_KEY=            # optional: arrival context
AEROXPLORER_API_SECRET=         # bearer tokens expire after 60 minutes

# ---- Media ------------------------------------------------------------------
# TikTok and Instagram oEmbed are both keyless as of 2026 — nothing to set here.
# Embeds resolve client-side; no video is ever downloaded or rehosted.
